---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Frame from '~/components/Frame.astro';
import Tag from '~/components/Tag.astro';
import { getProjects, projectUrl, type Project } from '~/lib/content';
import '~/styles/prose.css';
import { trackAttrs } from '~/lib/analytics';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, index: i, prev: projects[i - 1], next: projects[i + 1] },
  }));
}) satisfies GetStaticPaths;

interface Props {
  project: Project;
  index: number;
  prev?: Project | undefined;
  next?: Project | undefined;
}

const { project, index, prev, next } = Astro.props;
const { title, summary, build, status, year, stack, cover, coverAlt, links } = project.data;
const { Content } = await render(project);
const live = status === 'live' || status === 'active';
---

<Base title={title} description={summary} type="article">
  <article class="project">
    <Frame corners="tri">
      <Tag label={`Project ${String(index + 1).padStart(2, '0')}`} />
      <h1>{title}.</h1>
      <p class="sub">{summary}</p>
    </Frame>

    <div class="meta">
      <dl class="kv">
        {build && (
          <>
            <dt>Build</dt>
            <dd>{build}</dd>
          </>
        )}
        <dt>Status</dt>
        <dd class:list={{ sig: live }}>{status}</dd>
        {year && (
          <>
            <dt>Year</dt>
            <dd>{year}</dd>
          </>
        )}
        {stack.length > 0 && (
          <>
            <dt>Stack</dt>
            <dd>{stack.join(' / ')}</dd>
          </>
        )}
      </dl>
      <div class="links">
        {links.live && (
          <a
            class="btn"
            href={links.live}
            {...trackAttrs('project-link', { project: project.id, kind: 'live' })}
          >
            Live ▸
          </a>
        )}
        {links.demo && (
          <a
            class="btn"
            href={links.demo}
            {...trackAttrs('project-link', { project: project.id, kind: 'demo' })}
          >
            Demo ▸
          </a>
        )}
        {links.repo && (
          <a
            class="btn ghost"
            href={links.repo}
            {...trackAttrs('project-link', { project: project.id, kind: 'repo' })}
          >
            Source
          </a>
        )}
      </div>
    </div>

    {cover && (
      <figure class="cover" class:list={{ svg: cover.format === 'svg' }}>
        <Image
          src={cover}
          alt={coverAlt ?? ''}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1240px) 1144px, 92vw"
          loading="eager"
        />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <nav class="pager mono" aria-label="More projects">
      {prev ? <a href={projectUrl(prev)}>◂ {prev.data.title}</a> : <span />}
      <a href="/projects">All work</a>
      {next ? <a href={projectUrl(next)}>{next.data.title} ▸</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .project {
    display: grid;
    gap: 40px;
    padding-top: 48px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 24px;
  }
  .links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .cover {
    margin: 0;
    border: 1px solid var(--line);
    background: var(--carbon);
  }
  .cover :global(img) {
    width: 100%;
    max-height: 70vh;
    object-fit: contain;
  }
  .cover.svg :global(img) {
    max-height: 320px;
    padding: 32px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    border-top: 1px solid var(--line);
    padding-top: 20px;
  }
  .pager a {
    color: var(--dim);
    text-decoration: none;
  }
  .pager a:hover {
    color: var(--signal);
  }
</style>
