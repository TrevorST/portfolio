---
import modelUrl from '~/assets/models/trv01.glb?url';
import Base from '~/layouts/Base.astro';
import Tag from '~/components/Tag.astro';
import SectionHead from '~/components/SectionHead.astro';
import Frame from '~/components/Frame.astro';
import LifeCanvas from '~/components/LifeCanvas.astro';
import ProjectCard from '~/components/ProjectCard.astro';
import PostList from '~/components/PostList.astro';
import Terminal from '~/components/terminal/Terminal.tsx';
import Portrait from '~/components/Portrait.astro';
import ExperienceList from '~/components/ExperienceList.astro';
import { dateRange, getExperience, getPosts, getProjects, terminalData } from '~/lib/content';
import { build, site } from '~/site.config';
import { commands } from '~/terminal/registry';
import { trackAttrs } from '~/lib/analytics';

const [projects, posts, jobs, termData] = await Promise.all([
  getProjects(),
  getPosts(),
  getExperience(),
  terminalData(),
]);
const current = jobs.find((j) => j.data.end === 'present');
const languages = site.skills.find((s) => s.group === 'Languages')?.items ?? [];
const HOME_CARDS = 6;
const selected = projects.slice(0, HOME_CARDS);
const activeCount = projects.filter(
  (p) => p.data.status === 'active' || p.data.status === 'live',
).length;
const visibleCommands = commands.filter((c) => !c.hidden).length;
const pad = (n: number) => String(n).padStart(2, '0');
---

<Base>
  <section slot="wide" class="hero" data-hero-root data-model-url={modelUrl} aria-label="Intro">
    <script is:inline>
      // Pick the hero before it paints: the 3D computer, or the flat terminal for
      // reduced motion, Save-Data, no WebGL, low-memory devices or ?flat.
      (() => {
        let mode = '3d';
        try {
          const n = navigator;
          if (
            new URLSearchParams(location.search).has('flat') ||
            matchMedia('(prefers-reduced-motion: reduce)').matches ||
            n.connection?.saveData ||
            (n.deviceMemory && n.deviceMemory < 2) ||
            !('WebGLRenderingContext' in window)
          )
            mode = 'flat';
        } catch {
          mode = 'flat';
        }
        document.documentElement.dataset.hero = mode;
      })();
    </script>
    <div class="stage">
      <canvas class="gl" data-hero-canvas aria-hidden="true"></canvas>
      <header class="intro">
        <LifeCanvas />
        <div class="hero-meta mono dim">
          <span>PORTFOLIO // {site.name.toUpperCase()}</span>
          <span data-clock>UTC --:--:--</span>
          <span>
            BUILD {build.version} · {build.commit}
          </span>
        </div>
        <Tag label="Full Stack / Platform Engineer" />
        <h1>
          Trevor
          <br />
          <span class="glitch" data-t="Taylor">
            Taylor
          </span>
          <br />
          <span class="thin">Software Engineer</span>
        </h1>
        <div class="hero-foot">
          <p class="lede">
            Software Engineer @ Toyota focused on solving hard problems, designing simple solutions,
            and writing clean, scalable code. I like to move fast, ship often, and exceed
            expectations.
          </p>
          <dl class="kv">
            {current && (
              <>
                <dt>Now</dt>
                <dd>
                  {current.data.role} · {current.data.org}
                </dd>
              </>
            )}
            <dt>Projects</dt>
            <dd>{pad(projects.length)} on file</dd>
            <dt>Active</dt>
            <dd>{pad(activeCount)} in development</dd>
            <dt>Blog</dt>
            <dd>
              {pad(posts.length)} {posts.length === 1 ? 'post' : 'posts'}
            </dd>
            <dt>Terminal</dt>
            <dd>{visibleCommands} commands, some unlisted</dd>
          </dl>
          <div class="cta">
            <a class="btn" href="#work">
              View work ▸
            </a>
            <a class="btn ghost" href="#terminal">
              Open terminal
            </a>
          </div>
        </div>
      </header>
      <p class="hint mono" aria-hidden="true">
        <span class="h-intro">Scroll to boot ↓</span>
        <span class="h-hold h-fine">Type to use the terminal · Esc releases · scroll on</span>
        <span class="h-hold h-coarse">Tap the screen to type · scroll on</span>
      </p>
      <input
        class="hero-input"
        data-hero-input
        type="text"
        aria-label="Terminal command"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="send"
      />
      <div
        class="sr-only hero-log"
        role="log"
        aria-live="polite"
        aria-label="Terminal output"
        data-hero-log
      ></div>
    </div>
    <span id="terminal" class="anchor" aria-hidden="true"></span>
    <div class="flat-term">
      <div class="term-copy">
        <p class="tag">
          <span>TRV.SYS {build.version} // Terminal</span>
        </p>
        <p class="lede">
          A real shell over the real site: its file system is every project and post here.
        </p>
        <ul class="hints mono">
          <li>
            <span class="sig">help</span> what it can do
          </li>
          <li>
            <span class="sig">ls projects</span> everything on file
          </li>
          <li>
            <span class="sig">open circleflow</span> jump to a project
          </li>
          <li>
            <span class="sig">contact</span> reach me
          </li>
        </ul>
        <p class="mono dim">Tab completes · ↑↓ history · Ctrl+L clears</p>
      </div>
      <div class="term-slot">
        <Terminal client:visible data={termData} />
      </div>
    </div>
  </section>
  <script type="application/json" id="terminal-data" set:html={JSON.stringify(termData)} />
  <section class="section" aria-labelledby="work">
    <SectionHead
      idx="01"
      title="Selected work"
      id="work"
      meta={`${pad(projects.length)} PROJECTS`}
    />
    <div class="grid">
      {selected.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>
    {projects.length > HOME_CARDS && (
      <a class="btn ghost" href="/projects">
        All {projects.length} projects ▸
      </a>
    )}
  </section>

  <section class="section" aria-labelledby="experience">
    <SectionHead
      idx="02"
      title="Experience"
      id="experience"
      meta={`${String(jobs.length).padStart(2, '0')} ROLES · SINCE ${jobs.at(-1)?.data.start.slice(0, 4) ?? ''}`}
    />
    <ExperienceList jobs={jobs} />
    <a class="btn ghost" href="/about">
      Full resume ▸
    </a>
  </section>

  <section class="section" aria-labelledby="blog">
    <SectionHead idx="03" title="Blog" id="blog" meta={`${pad(posts.length)} POSTS · RSS`} />
    <PostList posts={posts.slice(0, 5)} />
    {posts.length > 5 && (
      <a class="btn ghost" href="/blog">
        All posts ▸
      </a>
    )}
  </section>

  <section class="section" aria-labelledby="about">
    <SectionHead idx="04" title="About" id="about" meta="ID // OPERATOR" />
    <div class="about">
      <Portrait />
      <div class="about-copy">
        <p class="lede">{site.bio}</p>
        <dl class="kv">
          {site.education.map((e) => (
            <>
              <dt>Education</dt>
              <dd>
                {e.degree}, {e.school} · {dateRange(e.start, e.end)}
              </dd>
            </>
          ))}
          <dt>Languages</dt>
          <dd>{languages.join(', ')}</dd>
        </dl>
        <a class="btn ghost" href="/about">
          Experience, education and skills ▸
        </a>
      </div>
    </div>
  </section>

  <section class="section contact" aria-labelledby="contact">
    <LifeCanvas density={0.14} opacity={0.6} fade={false} interactive class="contact-life" />
    <Frame variant="flood" as="div">
      <Tag label="Contact" class="flood-tag" decode={false} />
      <h2 id="contact">Let's talk.</h2>
      <p class="sub">
        Email is fastest:{' '}
        <a
          href={`mailto:${site.email}`}
          {...trackAttrs('contact-click', { channel: 'email', from: 'home' })}
        >
          {site.email}
        </a>
      </p>
      <div class="cta">
        <a
          class="btn dark"
          href={`mailto:${site.email}`}
          {...trackAttrs('contact-click', { channel: 'email', from: 'home' })}
        >
          Email me ▸
        </a>
        {site.links.map((l) => (
          <a
            class="btn dark ghost"
            href={l.href}
            rel="me"
            {...trackAttrs('contact-click', { channel: l.label.toLowerCase(), from: 'home' })}
          >
            {l.label}
          </a>
        ))}
      </div>
    </Frame>
  </section>
</Base>

<script>
  import '~/hero/controller';

  const el = document.querySelector<HTMLElement>('[data-clock]');
  if (el) {
    const tick = () => (el.textContent = `UTC ${new Date().toISOString().slice(11, 19)}`);
    tick();
    setInterval(tick, 1000);
  }
</script>

<style>
  /* ---------- hero: shared ---------- */
  .hero {
    position: relative;
    z-index: 1;
    border-bottom: 1px solid var(--line);
  }
  /* the hero sits outside the centred column; the flat layout re-centres */
  .stage,
  .flat-term {
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .intro {
    position: relative;
    padding-block: 56px 48px;
    display: grid;
    gap: 28px;
  }
  .intro > :global(*) {
    position: relative;
  }
  .intro > :global(canvas) {
    position: absolute;
  }
  .gl,
  .hint,
  .hero-input,
  .hero-log {
    display: none;
  }

  /* ---------- hero: 3D (html[data-hero='3d']) ---------- */
  :global(html[data-hero='3d']) .hero {
    height: 380svh;
    border-bottom: 0;
  }
  :global(html[data-hero='3d']) .stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    max-width: none;
    padding-inline: 0;
    background: var(--void);
  }
  :global(html[data-hero='3d']) .gl {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.6s steps(6);
  }
  :global(html[data-hero='3d']) .hero[data-ready] .gl {
    opacity: 1;
  }
  :global(html[data-hero='3d']) .intro {
    position: absolute;
    inset: 0;
    /* full bleed: the headline anchors to the left edge, whatever the width */
    max-width: none;
    padding: calc(var(--bar-h) + 28px) clamp(var(--gutter), 5vw, 112px) 88px;
    grid-template-rows: 1fr auto auto auto;
    align-content: stretch;
    pointer-events: none;
    opacity: clamp(0, calc(1 - var(--p, 0) * 5), 1);
    transform: translateY(calc(var(--p, 0) * -160px));
  }
  :global(html[data-hero='3d']) .intro :global(a) {
    pointer-events: auto;
  }
  :global(html[data-hero='3d']) .intro > :global(canvas) {
    display: none; /* the Game of Life belongs to the flat hero */
  }
  :global(html[data-hero='3d']) .intro h1 {
    font-size: clamp(3rem, 7.6vw, 13rem);
    max-width: 11ch;
  }
  :global(html[data-hero='3d']) .hero-meta {
    align-self: start; /* the readouts ride along the top edge */
  }
  :global(html[data-hero='3d']) .hero-foot {
    max-width: 44rem;
  }
  @media (orientation: portrait) {
    /* phones and tall windows: the name big and centred up top, the computer below it */
    :global(html[data-hero='3d']) .intro {
      grid-template-rows: auto auto auto 1fr;
      align-content: start;
      justify-items: center;
      text-align: center;
      gap: 14px;
      padding-top: calc(var(--bar-h) + 22px);
    }
    :global(html[data-hero='3d']) .hero-meta {
      justify-content: center;
    }
    :global(html[data-hero='3d']) .intro h1 {
      /* TREVOR is about 6.2em wide: 13.5vw keeps it on one line with the gutters */
      font-size: clamp(2.5rem, 13.5vw, 8rem);
      max-width: none;
      overflow-wrap: normal;
      white-space: nowrap;
    }
    :global(html[data-hero='3d']) .hero-foot {
      display: none; /* the computer sits in the lower half on phones */
    }
  }
  :global(html[data-hero='3d']) .hint {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 22px;
    max-width: none;
    text-align: center;
    color: var(--dim);
    pointer-events: none;
  }
  .h-hold {
    display: none;
  }
  :global(html[data-hero='3d']) .hero[data-hold] .h-intro {
    display: none;
  }
  :global(html[data-hero='3d']) .hero[data-hold] .h-hold.h-fine {
    display: inline;
  }
  @media (pointer: coarse) {
    :global(html[data-hero='3d']) .hero[data-hold] .h-hold.h-fine {
      display: none;
    }
    :global(html[data-hero='3d']) .hero[data-hold] .h-hold.h-coarse {
      display: inline;
    }
  }
  .h-intro {
    opacity: clamp(0, calc(1 - var(--p, 0) * 8), 1);
  }
  :global(html[data-hero='3d']) .hero-input {
    display: block;
    position: absolute;
    z-index: 3;
    opacity: 0;
    font-size: 16px; /* no iOS zoom on focus */
    border: 0;
    padding: 0;
    background: transparent;
    color: transparent;
    caret-color: transparent;
    cursor: text;
    pointer-events: none;
  }
  :global(html[data-hero='3d']) .hero[data-hold] .hero-input {
    pointer-events: auto;
  }
  :global(html[data-hero='3d']) .hero-log {
    display: block;
  }
  .anchor {
    display: block; /* flat: sits just above the terminal */
  }
  :global(html[data-hero='3d']) .anchor {
    position: absolute;
    /* scrolling here lands mid-hold: the screen fills the view */
    top: calc((100% - 100svh) * 0.5);
  }
  :global(html[data-hero='3d']) .flat-term {
    display: none; /* hidden, so its React island never hydrates */
  }
  .hero-meta {
    display: flex;
    justify-content: space-between;
    gap: 8px 16px;
    flex-wrap: wrap;
  }
  h1 {
    font-size: var(--s-hero);
    font-weight: 900;
    font-variation-settings: 'wdth' 150;
    letter-spacing: -0.02em;
    line-height: 0.82;
    overflow-wrap: anywhere;
  }
  .thin {
    font-weight: 300;
    font-variation-settings: 'wdth' 50;
    color: var(--dim);
    letter-spacing: 0;
  }
  .glitch {
    position: relative;
    display: inline-block;
    color: var(--signal);
  }
  .glitch::before,
  .glitch::after {
    content: attr(data-t);
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
  }
  .glitch::before {
    color: var(--flare);
    clip-path: inset(0 0 62% 0);
    animation: gl 3.2s infinite steps(1);
  }
  .glitch::after {
    color: var(--bone);
    clip-path: inset(70% 0 8% 0);
    animation: gl 2.7s infinite steps(1) reverse;
  }
  @keyframes gl {
    0%,
    86%,
    100% {
      opacity: 0;
    }
    88% {
      opacity: 1;
      transform: translate(-5px, 1px);
    }
    92% {
      opacity: 1;
      transform: translate(3px, -1px);
    }
    95% {
      opacity: 0;
    }
  }
  .hero-foot {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 24px;
    align-items: end;
  }
  .cta {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---------- hero: flat fallback ---------- */
  .flat-term {
    display: grid;
    gap: 24px;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    align-items: stretch;
    padding-block: 8px 56px;
  }
  @media (max-width: 860px) {
    .flat-term {
      grid-template-columns: 1fr;
    }
  }
  .term-copy {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .hints {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .hints li {
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--dim);
  }
  .term-slot {
    height: clamp(22rem, 60vh, 32rem);
  }

  .about {
    display: grid;
    gap: 32px;
    grid-template-columns: minmax(0, 320px) minmax(0, 1fr);
    align-items: start;
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
    .about :global(.portrait) {
      max-width: 280px;
    }
  }
  .about-copy {
    display: grid;
    gap: 24px;
  }

  .contact {
    position: relative;
    padding-top: 96px;
    padding-bottom: 96px;
  }
  /* Life plays on the void around the panel and bleeds past its edges; the
     solid green panel sits on top of it */
  .contact :global(.contact-life) {
    inset: 0 calc(-1 * var(--gutter));
    width: calc(100% + 2 * var(--gutter));
    z-index: 0;
    -webkit-mask: radial-gradient(ellipse at center, #000 60%, transparent 98%);
    mask: radial-gradient(ellipse at center, #000 60%, transparent 98%);
  }
  .contact :global(.frame) {
    z-index: 1;
  }
  .contact :global(.flood-tag) {
    color: var(--void);
    background: none;
  }
  .btn.dark {
    background: var(--void);
    border-color: var(--void);
    color: var(--signal);
  }
  .btn.dark.ghost {
    background: transparent;
    color: var(--void);
  }
  .btn.dark:hover {
    background: var(--bone);
    border-color: var(--bone);
    color: var(--void);
  }
</style>
