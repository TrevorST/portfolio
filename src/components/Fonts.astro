---
/**
 * Self-hosted variable fonts, latin subset only (~125 KB total).
 *
 * They are preloaded and use `font-display: block` instead of Fontsource's
 * `swap`: the hero is set in an ultra-wide face, so swapping from a fallback
 * reflows the whole page (measured CLS 0.17-0.3). Preloading makes the block
 * period short enough that it is invisible in practice.
 */
import anybody from '@fontsource-variable/anybody/files/anybody-latin-standard-normal.woff2?url';
import martian from '@fontsource-variable/martian-mono/files/martian-mono-latin-standard-normal.woff2?url';
import geist from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';

const LATIN =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';

const faces = [
  { family: 'Anybody Variable', src: anybody, weight: '100 900', stretch: '50% 150%' },
  { family: 'Martian Mono Variable', src: martian, weight: '100 800', stretch: '75% 112.5%' },
  { family: 'Geist Variable', src: geist, weight: '100 900' },
];

const css = faces
  .map(
    (f) =>
      `@font-face{font-family:'${f.family}';font-style:normal;font-display:block;font-weight:${f.weight};${
        f.stretch ? `font-stretch:${f.stretch};` : ''
      }src:url(${f.src}) format('woff2-variations');unicode-range:${LATIN}}`,
  )
  .join('');
---

{faces.map((f) => (
  <link rel="preload" href={f.src} as="font" type="font/woff2" crossorigin />
))}
<style is:inline set:html={css} />
