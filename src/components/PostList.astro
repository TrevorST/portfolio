---
import { isoDate, postUrl, type Post } from '~/lib/content';

interface Props {
  posts: Post[];
}
const { posts } = Astro.props;
---

{posts.length === 0 ? (
  <p class="mono dim">// NO POSTS YET //</p>
) : (
  <ol class="posts">
    {posts.map((post, i) => (
      <li>
        <span class="n mono">{`W.${String(posts.length - i).padStart(2, '0')}`}</span>
        <div class="body">
          <p class="mono dim">
            <time datetime={post.data.date.toISOString()}>{isoDate(post.data.date)}</time>
            {post.data.tags.length > 0 && ` · ${post.data.tags.join(' / ').toUpperCase()}`}
          </p>
          <h3>
            <a href={postUrl(post)}>{post.data.title}</a>
          </h3>
          <p class="summary">{post.data.summary}</p>
        </div>
      </li>
    ))}
  </ol>
)}

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  li {
    position: relative;
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  li:hover .n,
  li:focus-within .n {
    color: var(--bone);
  }
  .n {
    color: var(--signal);
    padding-top: 4px;
  }
  .body {
    display: grid;
    gap: 6px;
  }
  h3 {
    font-size: clamp(1.4rem, 3vw, 2.1rem);
    font-weight: 850;
    font-variation-settings: 'wdth' 130;
  }
  h3 a {
    color: var(--bone);
    text-decoration: none;
  }
  h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  li:hover h3 a,
  h3 a:focus-visible {
    color: var(--signal);
  }
  .summary {
    font-size: var(--s-sm);
    color: var(--bone-2);
  }
</style>
